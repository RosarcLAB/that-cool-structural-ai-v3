# Production build config. Vite loads this automatically for `npm run build`.
# Local development keeps using .env (localhost URLs) - do not merge the two.
#
# Every value here is a VITE_ variable, so it IS bundled into client-side JS
# and is public by design. Nothing secret belongs in this file.
#   - Firebase web config is public by design (secured by Firestore rules).
#   - Cloud Run URLs are public endpoints (protected by Firebase ID tokens).

# Backend services (europe-west2)
VITE_ORCHESTRATOR_BASE=https://rosarcbim-orchestrator-701061055216.europe-west2.run.app
VITE_API_BASE=https://rosarcbim-structural-api-701061055216.europe-west2.run.app

# Firebase web config
VITE_FIREBASE_API_KEY=AIzaSyD5-KdjJ1N-dY_NS7LhwOs4J8eXcLQTq-M
VITE_FIREBASE_AUTH_DOMAIN=rosarclab-web.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=rosarclab-web
VITE_FIREBASE_STORAGE_BUCKET=rosarclab-web.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=701061055216
VITE_FIREBASE_APP_ID=1:701061055216:web:45a7236f37ab76f56c7835

# NOTE: VITE_GOOGLE_API_KEY is deliberately absent. It must never ship to the
# browser; vite.config.ts also zeroes it at build time. AI calls go through
# the orchestrator, which holds the key server-side via Secret Manager.
