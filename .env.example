# Copy to .env and fill in. NEVER commit the real .env.
# Anything prefixed VITE_ is bundled into client-side JS and is PUBLIC.

# Firebase web config — safe to expose by design (locked down by Firebase rules)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Backend base URLs (no secrets). Point at the Cloud Run service.
VITE_API_BASE=http://localhost:8000
VITE_ORCHESTRATOR_BASE=http://localhost:8000

# DO NOT add a Gemini key here. AI calls go through the backend orchestrator,
# which holds GOOGLE_API_KEY server-side. A VITE_GOOGLE_API_KEY would be exposed
# to every visitor's browser.
